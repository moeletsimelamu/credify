# Copy to .env and replace every placeholder. Never commit .env.
# All values below are placeholders; none are real credentials.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=credify
POSTGRES_USER=credify
POSTGRES_PASSWORD=<generate-a-local-db-password>
POSTGRES_TEST_DB=credify_test
POSTGRES_HOST_PORT=5433

# --- API ---
CREDIFY_ENVIRONMENT=development
# Used when running the API/Alembic on the host (inside compose the URL is built for you).
CREDIFY_DATABASE_URL=postgresql+psycopg://credify:<db-password>@127.0.0.1:5433/credify
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDIFY_JWT_SECRET=<generate-a-random-48-byte-value>
CREDIFY_CORS_ORIGINS=http://localhost:5173
# Must be true in production (HTTPS). false only for local http://localhost.
CREDIFY_COOKIE_SECURE=false
CREDIFY_LOG_LEVEL=INFO
CREDIFY_LOG_JSON=true
API_HOST_PORT=8000
# The web app (nginx) in docker compose; `npm run dev` uses http://localhost:5173 instead.
WEB_HOST_PORT=8090

# --- Tests (host) ---
CREDIFY_TEST_DATABASE_URL=postgresql+psycopg://credify:<db-password>@127.0.0.1:5433/credify_test
